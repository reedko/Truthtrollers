{
  "extends": "./tsconfig.cfx.json",
  "compilerOptions": {
    "noEmit": false,
    "allowJs": true,
    "checkJs": false,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": false,
    "sourceMap": true
  },
  "include": [
    "src/claimfoundry/cfx/**/*.ts",
    "src/claimfoundry/shared/**/*.ts"
  ],
  "exclude": [
    "src/claimfoundry/cfx/runtime/runCurrentFixtureEndChain.ts"
  ]
}
