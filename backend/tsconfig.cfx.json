{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "src/claimfoundry/cfx/**/*.ts",
    "src/claimfoundry/shared/**/*.ts",
    "test/claimfoundry/cfx/**/*.ts"
  ]
}
