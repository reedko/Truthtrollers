# Publisher enrichment credentials (leave empty in source control)
OPENALEX_API_KEY=
GOOGLE_FACT_CHECK_API_KEY=
OPENCORPORATES_API_KEY=

# Publisher enrichment provider gates
WIKIPEDIA_PERENNIAL_SOURCES_ENABLED=true
OPENALEX_ENABLED=true
GOOGLE_FACT_CHECK_ENABLED=true
OPENCORPORATES_ENABLED=false
ADFONTES_ENABLED=false
ALLSIDES_ENABLED=false

# Allows Tavily search results to be interpreted by an LLM for publisher
# ratings. Keep false unless this non-authoritative fallback is explicitly wanted.
PUBLISHER_ENRICHMENT_ALLOW_SEARCH_LLM_FALLBACK=false
ENABLE_BEARING_SHADOW=false
ENABLE_BEARING_GATING=true
ENABLE_SNIPPET_BEARING_LLM=true
ENABLE_BEARING_PACKET=true
ENABLE_BEARING_PACKET_LIVE=true

# Claim repair pass: run targeted repair for coverage gaps after theme fusion
CLAIM_REPAIR_PASS=false

# Evidence retrieval gateway. API keys are never returned by the admin API.
ENABLE_SEARCH_GATEWAY=true
SEARCH_PROVIDER=tavily
SEARCH_PROVIDERS=tavily,brave,serpapi
SEARCH_PROVIDER_FALLBACKS=brave,serpapi,tavily
RETRIEVAL_STRATEGY=best_bearing_pool
MIN_HIGH_BEARING_CLAIMS_PER_TARGET=5
ENABLE_BRAVE_SEARCH=false
ENABLE_SERPAPI_SEARCH=false
ENABLE_SEARCH_ENSEMBLE=false
ENABLE_PROVIDER_METADATA_CAPTURE=true
ENABLE_PROVIDER_METADATA_IN_SNIPPET_FALLBACK=false
SEARCH_MAX_RESULTS_PER_QUERY=10
SEARCH_PROVIDER_BUDGET_PER_TARGET_USD=0.05
SEARCH_MAX_PROVIDERS_PER_TARGET=7
SEARCH_MAX_SOURCES_TO_SCRAPE_PER_TARGET=10
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
SERPAPI_API_KEY=
BING_SEARCH_API_KEY=
PUBMED_API_KEY=
CROSSREF_MAILTO=
OPENALEX_MAILTO=
SEMANTIC_SCHOLAR_API_KEY=

# CFX is the production evidence pipeline by default. Set the first flag to
# false to pause its scrape-resume consumer, or enable legacy only for an
# explicit emergency rollback.
CFX_PRODUCTION_EVIDENCE_ENABLED=true
CFX_LEGACY_EVIDENCE_ENABLED=false
CFX_WEB_PROVIDER=tavily
CFX_TARGETED_BEARING_MODEL=gpt-4o-mini
CFX_DOCUMENT_BEARING_MODEL=gpt-4o-mini
# Safe vertical-slice defaults. Raising either value requires a reviewed run.
CFX_MAX_CANONICAL_DOCUMENTS=1
CFX_MAX_DOCUMENT_BEARING_CALLS=1

# Assertion-relative packet-selection/extraction seam (experimental, ends
# before persistence). Defaults to false: the existing document-centric
# bearingProcessor path stays the default until this is proven live.
CFX_ASSERTION_RELATIVE_EXTRACTION_ENABLED=false
CFX_ASSERTION_RELATIVE_EXTRACTION_MODEL=gpt-4o-mini
CFX_PACKET_SELECTION_PYTHON_EXECUTABLE=python3
CFX_PACKET_SELECTION_EMBEDDING_MODEL_CACHE=
CFX_PACKET_SELECTION_EMBEDDING_CACHE=
CFX_PACKET_SELECTION_LEXICAL_ONLY=false

# Provisional source-assertion persistence for the assertion-relative seam
# (ends before link suggestion). Defaults to false and has no effect unless
# CFX_ASSERTION_RELATIVE_EXTRACTION_ENABLED is also true.
CFX_ASSERTION_RELATIVE_SOURCE_PERSISTENCE_ENABLED=false

# Batched link suggestion over this run's persisted provisional source
# assertions. Defaults to false and has no effect unless both
# CFX_ASSERTION_RELATIVE_EXTRACTION_ENABLED and
# CFX_ASSERTION_RELATIVE_SOURCE_PERSISTENCE_ENABLED are also true.
CFX_ASSERTION_RELATIVE_LINK_SUGGESTION_ENABLED=false
CFX_ASSERTION_RELATIVE_LINK_SUGGESTION_MODEL=gpt-4o-mini
